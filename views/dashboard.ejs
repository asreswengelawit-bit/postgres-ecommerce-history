<%- include('partials/header') %>

<div class="container">
  
  <!-- Dashboard Header -->
  <div class="store-header" style="margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 8px;" id="dashboard-store-title">Store Dashboard</h1>
      <p style="color: var(--text-secondary);" id="dashboard-store-desc">Manage products, view analytics, and fulfill orders.</p>
    </div>
    <div>
      <button class="btn btn-primary" onclick="openProductModal()">
        <i class="fa-solid fa-plus"></i> Add New Product
      </button>
    </div>
  </div>

  <!-- Statistics cards -->
  <div class="dashboard-grid">
    <div class="glass-panel stat-card">
      <span class="stat-title"><i class="fa-solid fa-hand-holding-dollar"></i> Gross Revenue</span>
      <span class="stat-value" id="stat-revenue">$0.00</span>
    </div>
    
    <div class="glass-panel stat-card">
      <span class="stat-title"><i class="fa-solid fa-boxes-packing"></i> Units Sold</span>
      <span class="stat-value" id="stat-orders">0</span>
    </div>

    <div class="glass-panel stat-card">
      <span class="stat-title"><i class="fa-solid fa-box"></i> Active Products</span>
      <span class="stat-value" id="stat-listings">0</span>
    </div>

    <div class="glass-panel stat-card">
      <span class="stat-title"><i class="fa-solid fa-triangle-exclamation"></i> Low Stock Alerts</span>
      <span class="stat-value" id="stat-alerts" style="color: var(--warning);">0</span>
    </div>
  </div>

  <!-- Main Panels Grid -->
  <div class="dashboard-sections">
    
    <!-- SECTION 1: Product Management -->
    <div class="glass-panel" style="padding: 30px;">
      <h3 style="font-weight: 600; font-size: 1.25rem; border-bottom: 1px solid var(--glass-border); padding-bottom: 15px; margin-bottom: 10px;">
        <i class="fa-solid fa-boxes-stacked"></i> Product Inventory Manager
      </h3>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Image</th>
              <th>Product Name</th>
              <th>Price</th>
              <th>Stock Level</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody id="inventory-table-body">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- SECTION 2: Order Fulfillment Manager -->
    <div class="glass-panel" style="padding: 30px;">
      <h3 style="font-weight: 600; font-size: 1.25rem; border-bottom: 1px solid var(--glass-border); padding-bottom: 15px; margin-bottom: 10px;">
        <i class="fa-solid fa-dolly"></i> Order Fulfillment Workbench
      </h3>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Product Name</th>
              <th>Qty</th>
              <th>Subtotal</th>
              <th>Address / Contact</th>
              <th>Shipment Status</th>
              <th style="text-align: right;">Fulfill / Update</th>
            </tr>
          </thead>
          <tbody id="orders-table-body">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

</div>

<!-- Product Editor Modal (Add/Edit Product) -->
<div id="product-modal" class="modal-overlay">
  <div class="glass-panel modal-card" style="max-width: 560px;">
    <span class="close-btn" onclick="closeProductModal()">&times;</span>
    <h2 id="product-modal-title" style="font-weight: 700; margin-bottom: 10px;">Add New Product</h2>
    <p style="color: var(--text-secondary); margin-bottom: 24px;">Provide the product listing details below.</p>

    <!-- Error alert inside modal -->
    <div id="product-modal-alert" style="display: none; padding: 12px; margin-bottom: 20px; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 500;"></div>

    <form id="product-form">
      <input type="hidden" id="edit-product-id">

      <div class="form-group">
        <label for="productName" class="form-label">Product Name</label>
        <input type="text" id="productName" class="form-control" placeholder="e.g. Mechanical Keyboard" required>
      </div>

      <div class="form-group">
        <label for="productDescription" class="form-label">Description</label>
        <textarea id="productDescription" class="form-control" rows="3" placeholder="Describe the item specs..." style="resize: none;"></textarea>
      </div>

      <div style="display: flex; gap: 20px;" class="form-group">
        <div style="flex: 1;">
          <label for="productPrice" class="form-label">Price ($ USD)</label>
          <input type="number" id="productPrice" class="form-control" step="0.01" min="0" placeholder="19.99" required>
        </div>
        <div style="flex: 1;">
          <label for="productStock" class="form-label">Stock Quantity</label>
          <input type="number" id="productStock" class="form-control" min="0" placeholder="50" required>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 30px;">
        <label for="productImageUrl" class="form-label">Image URL</label>
        <input type="url" id="productImageUrl" class="form-control" placeholder="https://example.com/image.jpg">
      </div>

      <div style="display: flex; gap: 16px;">
        <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="closeProductModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" style="flex: 2;" id="product-submit-btn">Save Product</button>
      </div>
    </form>
  </div>
</div>

<!-- Fulfillment Details Modal (Allows updating status with details) -->
<div id="fulfill-modal" class="modal-overlay">
  <div class="glass-panel modal-card" style="max-width: 500px;">
    <span class="close-btn" onclick="closeFulfillModal()">&times;</span>
    <h2 style="font-weight: 700; margin-bottom: 10px;">Fulfill Order Item</h2>
    <p style="color: var(--text-secondary); margin-bottom: 24px;">Update shipping progress and log tracking details.</p>

    <!-- Alert banner -->
    <div id="fulfill-modal-alert" style="display: none; padding: 12px; margin-bottom: 20px; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 500;"></div>

    <form id="fulfill-form">
      <input type="hidden" id="fulfill-item-id">

      <div class="form-group">
        <label for="fulfillStatus" class="form-label">Shipment Status</label>
        <select id="fulfillStatus" class="form-control" style="background: var(--bg-secondary); border-color: var(--glass-border);" required>
          <option value="Pending">Pending</option>
          <option value="Processing">Processing</option>
          <option value="Shipped">Shipped</option>
          <option value="Delivered">Delivered</option>
          <option value="Cancelled">Cancelled</option>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 30px;">
        <label for="fulfillDescription" class="form-label">Fulfillment/Courier Description Notes</label>
        <textarea id="fulfillDescription" class="form-control" rows="3" placeholder="e.g. Package dispatched via DHL. Tracking reference: DHL-12345." style="resize: none;" required></textarea>
      </div>

      <div style="display: flex; gap: 16px;">
        <button type="button" class="btn btn-secondary" style="flex: 1;" onclick="closeFulfillModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" style="flex: 2;">Save Progress Update</button>
      </div>
    </form>
  </div>
</div>

<!-- Dashboard client orchestration script -->
<script src="/js/dashboard.js"></script>

<%- include('partials/footer') %>
